{
  "compilerOptions": {
    "target": "es2020",                  // Código JS moderno, pero compatible
    "module": "commonjs",                // Para usar require/module.exports
    "rootDir": "./src",                  // Tu código fuente en TypeScript
    "outDir": "./dist",                  // Si algún día hacés build tradicional
    "strict": true,                      // Activá todas las comprobaciones fuertes
    "esModuleInterop": true,             // Permite importar módulos CommonJS con "import"
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
